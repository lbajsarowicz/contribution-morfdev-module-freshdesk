{
    "name": "morfdev/module-freshdesk",
    "description": "The extension connect Magento 2 stores with Freshworks products (Freshdesk/Freshsales/Freshservice/Freshchat) via Magento 2 Connector app",
    "type": "magento2-module",
    "version": "1.0.9",
    "license": [
        "proprietary"
    ],
    "require": {
        "php": ">=5.6.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Morfdev\\Freshdesk\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
